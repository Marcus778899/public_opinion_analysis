# 複製成 .env 後填入實際值：cp .env.example .env
# 各階段新增的環境變數都要補在這裡（見 docs/development-spec.md 4.2）

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# loggerhelper：LOG_NAME 在 docker-compose 中依服務設定
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# LOG_DIR=./log

# 選填：設定後 WARNING 以上的 log 會送到 Slack（擇一）
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=#alerts
# SLACK_ENV=dev
