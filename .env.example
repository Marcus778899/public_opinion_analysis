# 複製成 .env 後填入實際值：cp .env.example .env
# 各階段新增的環境變數都要補在這裡（見 docs/development-spec.md 4.2）

# ---------- 元件版本（docker-compose 使用）----------
KAFKA_VERSION=4.1.0
POSTGRES_VERSION=17
KAFKA_UI_VERSION=v1.3.0
# Debezium / Apicurio / ClickHouse 的組合經 S2-01 驗證，升級前先看設計文件 6.2
DEBEZIUM_VERSION=3.7.0.Final
APICURIO_VERSION=3.3.3
CLICKHOUSE_VERSION=26.8

# ---------- Kafka 叢集 ----------
# 叢集唯一 ID（可用 kafka-storage.sh random-uuid 產生）
CLUSTER_ID=xDC5zrWuSheLy0eGha9XeQ
KAFKA_QUORUM_VOTERS=1@kafka_1:9093,2@kafka_2:9093,3@kafka_3:9093
# 每個節點各自的 heap，3 節點合計約 768MB～1.5GB
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
# 外部連線 host（開發環境為 localhost，正式環境為 domain 或外部 IP）
KAFKA_EXTERNAL_HOST=localhost

# ---------- 應用程式連線 ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# ---------- CDC（Kafka Connect + Debezium + Apicurio）----------
CONNECT_HEAP_OPTS="-Xms256m -Xmx768m"
APICURIO_JAVA_OPTS="-Xmx384m"
# 本機執行 make connector 時的 Connect REST API；docker-compose 內會改成 http://connect:8083
CONNECT_URL=http://localhost:8083
# 以下由 connector 在 compose 網路內使用，填 compose 的服務名稱
CDC_DATABASE_HOST=postgres
CDC_REGISTRY_URL=http://apicurio:8080/apis/registry/v3

# ---------- ClickHouse ----------
# NOTE: 使用者名稱需與 infra/clickhouse/users.d/radar.xml 一致
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=radar
CLICKHOUSE_USER=radar
CLICKHOUSE_PASSWORD=change-me

# 本機執行串流標註時的 schema registry（Apicurio 的 Confluent 相容 API）；compose 內會改成 apicurio
# SCHEMA_REGISTRY_URL=http://localhost:8080/apis/ccompat/v7

# ---------- LLM 標註（階段 3，開發規格 7.11）----------
# API key 只放 .env，不進 repo
# 主要標註者的服務商（backfill 固定用它）與串流標註的備援順序：gemini | groq | openrouter
# LABEL_PRIMARY=groq
# LABEL_FALLBACKS=gemini
# 內文截斷長度（字）
# LABEL_MAX_CHARS=2000

GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MIN_INTERVAL_S=2.0

GEMINI_API_KEY=
# 額度以「專案 × 模型」計算；gemini-3.5-flash 免費只有 20 次/天
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MIN_INTERVAL_S=4.0

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------- 管理 API ----------
# 允許跨網域呼叫的來源（逗號分隔），例：https://radar.example.com,http://localhost:3000
# 留空代表不開放任何跨網域請求
API_CORS_ORIGINS=

# ---------- Scheduler（以下皆為預設值，可不設定）----------
# 本機執行時的 API 位址；docker-compose 內會改成 http://api:8000
# SCHEDULER_API_URL=http://localhost:8000
# SCHEDULER_DUE_POSTS_LIMIT=500

# ---------- 爬蟲（以下皆為預設值，可不設定）----------
# 每次請求間隔 2 秒 + 0～2 秒隨機，3 個爬蟲合計約 1 次/秒
# CRAWLER_MIN_INTERVAL_S=2.0
# CRAWLER_JITTER_S=2.0

# ---------- loggerhelper：LOG_NAME 在 docker-compose 中依服務設定 ----------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# LOG_DIR=./log

# 選填：設定後 WARNING 以上的 log 會送到 Slack（擇一）
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=#alerts
# SLACK_ENV=dev
