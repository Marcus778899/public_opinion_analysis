# 複製成 .env 後填入實際值：cp .env.example .env
# 各階段新增的環境變數都要補在這裡（見 docs/development-spec.md 4.2）

# ---------- 元件版本（docker-compose 使用）----------
KAFKA_VERSION=4.1.0
POSTGRES_VERSION=17
KAFKA_UI_VERSION=v1.3.0

# ---------- Kafka 叢集 ----------
# 叢集唯一 ID（可用 kafka-storage.sh random-uuid 產生）
CLUSTER_ID=xDC5zrWuSheLy0eGha9XeQ
KAFKA_QUORUM_VOTERS=1@kafka_1:9093,2@kafka_2:9093,3@kafka_3:9093
# 每個節點各自的 heap，3 節點合計約 768MB～1.5GB
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
# 外部連線 host（開發環境為 localhost，正式環境為 domain 或外部 IP）
KAFKA_EXTERNAL_HOST=localhost

# ---------- 應用程式連線 ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# ---------- loggerhelper：LOG_NAME 在 docker-compose 中依服務設定 ----------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# LOG_DIR=./log

# 選填：設定後 WARNING 以上的 log 會送到 Slack（擇一）
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=#alerts
# SLACK_ENV=dev
