# 複製成 .env 後填入實際值：cp .env.example .env
# 各階段新增的環境變數都要補在這裡（見 docs/development-spec.md 4.2）

# ---------- 元件版本（docker-compose 使用）----------
KAFKA_VERSION=4.1.0
POSTGRES_VERSION=17
KAFKA_UI_VERSION=v1.3.0
# Debezium / Apicurio / ClickHouse 的組合經 S2-01 驗證，升級前先看設計文件 6.2
DEBEZIUM_VERSION=3.7.0.Final
APICURIO_VERSION=3.3.3
CLICKHOUSE_VERSION=26.8
# Grafana 與 ClickHouse plugin 都釘完整 patch 號（開發規格 7.25）
GRAFANA_VERSION=13.0.2
GRAFANA_CLICKHOUSE_PLUGIN_VERSION=4.23.0

# ---------- 整合測試（compose.ci.yaml，只有 CI 用；本機 run --rm test 不需要）----------
IT_KAFKA_HOST_PORT=19092
IT_POSTGRES_HOST_PORT=15432
IT_CLICKHOUSE_HOST_PORT=18123
IT_GRAFANA_HOST_PORT=13000

# ---------- Kafka 叢集 ----------
# 叢集唯一 ID（可用 kafka-storage.sh random-uuid 產生）
CLUSTER_ID=xDC5zrWuSheLy0eGha9XeQ
KAFKA_QUORUM_VOTERS=1@kafka_1:9093,2@kafka_2:9093,3@kafka_3:9093
# 每個節點各自的 heap，3 節點合計約 768MB～1.5GB
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
# 外部連線 host（開發環境為 localhost，正式環境為 domain 或外部 IP）
KAFKA_EXTERNAL_HOST=localhost

# ---------- 應用程式連線 ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# ---------- CDC（Kafka Connect + Debezium + Apicurio）----------
CONNECT_HEAP_OPTS="-Xms256m -Xmx768m"
APICURIO_JAVA_OPTS="-Xmx384m"
# 本機執行 make connector 時的 Connect REST API；docker-compose 內會改成 http://connect:8083
CONNECT_URL=http://localhost:8083
# 以下由 connector 在 compose 網路內使用，填 compose 的服務名稱
CDC_DATABASE_HOST=postgres
CDC_REGISTRY_URL=http://apicurio:8080/apis/registry/v3
# cdc-watchdog（開發規格 7.16）；以下為預設值，通常不必設定
# CDC_WATCHDOG_INTERVAL_S=30
# CDC_WATCHDOG_RESTART_BACKOFF_INITIAL_S=30
# CDC_WATCHDOG_RESTART_BACKOFF_MAX_S=600
# CDC_WATCHDOG_SLOT_INACTIVE_ALERT_S=300
# CDC_WATCHDOG_SLOT_LAG_ALERT_BYTES=268435456
# CDC_WATCHDOG_REQUEST_TIMEOUT_S=10
# 選填：外部 heartbeat（healthchecks.io 的 ping URL）。watchdog 停止或 CDC 異常時由對方寄 email
# 建 check 時設 Period 1 分鐘、Grace 5 分鐘；留空則不送
# CDC_WATCHDOG_HEARTBEAT_URL=https://hc-ping.com/<uuid>

# ---------- ClickHouse ----------
# NOTE: 使用者名稱需與 infra/clickhouse/users.d/radar.xml 一致
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=radar
CLICKHOUSE_USER=radar
CLICKHOUSE_PASSWORD=change-me
# Grafana 專用唯讀帳號；名稱固定為 grafana（infra/clickhouse/users.d/grafana.xml）
CLICKHOUSE_GRAFANA_USER=grafana
CLICKHOUSE_GRAFANA_PASSWORD=change-me

# ---------- Grafana（開發規格 7.25，只綁 127.0.0.1）----------
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# 本機執行串流標註時的 schema registry（Apicurio 的 Confluent 相容 API）；compose 內會改成 apicurio
# SCHEMA_REGISTRY_URL=http://localhost:8080/apis/ccompat/v7

# ---------- LLM 標註（階段 3，開發規格 7.11）----------
# API key 只放 .env，不進 repo
# 主要標註者的服務商（backfill 固定用它）與串流標註的備援順序：gemini | groq | openrouter
# LABEL_PRIMARY=groq
# LABEL_FALLBACKS=gemini
# 內文截斷長度（字）
# LABEL_MAX_CHARS=2000

GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MIN_INTERVAL_S=2.0

# GEMINI_API_KEY=
# 額度以「專案 × 模型」計算；gemini-3.5-flash 免費只有 20 次/天
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MIN_INTERVAL_S=4.0

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------- 情緒推論（階段 4，開發規格 7.18）----------
# make up-inference 使用：models/ 下的模型版本（例如 tfidf-lr-20261016T0300）；compose 會掛載為 /app/models/<版本>
# INFERENCE_MODEL_VERSION=
# 本機執行 python -m radar.ml.inference.main 時直接指定模型資料夾
# INFERENCE_MODEL_DIR=models/<model_version>
# INFERENCE_CACHE_SIZE=200000
# INFERENCE_BATCH_SIZE=100
# ONNX 模型的 intra-op thread 數（D-023）；shadow 服務在 compose 固定為 2
# INFERENCE_THREADS=2
# ONNX 每次推論的篇數 × 序列長度上限（預設 4096；須 ≥ 模型 max_len）
# INFERENCE_MAX_BATCH_TOKENS=4096

# ---------- shadow 推論（階段 8，開發規格 7.27）----------
# make up-shadow 使用：models/ 下要並行比較的模型版本（例如 bert-macbert-202610210300）
# INFERENCE_SHADOW_MODEL_VERSION=

# ---------- 熱度偵測（階段 5，開發規格 7.20）----------
# 回放與驗收時改成 replay.cdc.comments，並換 consumer group（state 才不會和正式的混在一起）
# HEAT_INPUT_TOPIC=cdc.public.comments
# HEAT_CONSUMER_GROUP=heat
# HEAT_STATE_DIR=state
# HEAT_WINDOW_MIN=10
# HEAT_GRACE_MIN=2
# HEAT_MAX_DELAY_MIN=30
# HEAT_STALE_AFTER_MIN=60
# HEAT_EWMA_ALPHA=0.02
# HEAT_MAX_GAP_MIN=1440
# HEAT_Z_THRESHOLD=3.0
# HEAT_MIN_COUNT=30
# HEAT_POST_MIN_COUNT=80
# HEAT_COOLDOWN_MIN=30
# HEAT_WARMUP_MIN=60
# HEAT_MIN_STD=1.0

# ---------- Telegram bot（階段 5，開發規格 7.21）----------
# 向 @BotFather 申請；make up-alerting 必填
TELEGRAM_BOT_TOKEN=
# 允許的 chat_id（逗號分隔）；必填，留空 bot 會拒絕啟動（D-010）
TELEGRAM_ALLOWED_CHAT_IDS=
# 要回應所有 chat（清單留空時）才設 true；清單有值時以清單為準並警告
# TELEGRAM_ALLOW_ALL=false
# TELEGRAM_POLL_TIMEOUT_S=30
# TELEGRAM_HOT_WINDOW_MIN=60
# TELEGRAM_HOT_LIMIT=5
# TELEGRAM_SENTIMENT_MIN_SCORE=0.5
# TELEGRAM_MUTE_RETENTION_H=48

# ---------- 管理 API ----------
# 允許跨網域呼叫的來源（逗號分隔），例：https://radar.example.com,http://localhost:3000
# 留空代表不開放任何跨網域請求
# API_CORS_ORIGINS=

# ---------- Scheduler（以下皆為預設值，可不設定）----------
# 本機執行時的 API 位址；docker-compose 內會改成 http://api:8000
# SCHEDULER_API_URL=http://localhost:8000
# SCHEDULER_DUE_POSTS_LIMIT=500

# ---------- 爬蟲（以下皆為預設值，可不設定）----------
# 每次請求間隔 2 秒 + 0～2 秒隨機，3 個爬蟲合計約 1 次/秒
# CRAWLER_MIN_INTERVAL_S=2.0
# CRAWLER_JITTER_S=2.0

# ---------- loggerhelper：LOG_NAME 在 docker-compose 中依服務設定 ----------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# LOG_DIR=./log

# 選填：設定後 SLACK_LOG_LEVEL 以上的 log 會送到 Slack；webhook 與 bot token 擇一
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_BOT_TOKEN=xoxb-...
# ⚠️ 填頻道識別碼（C 開頭，在頻道資訊最下方「頻道識別碼」複製），不要填頻道名稱：
# 「#頻道名稱」的 # 會被 uv --env-file 當成註解而讀到空值（compose 不會），本機執行的程式就沒有 Slack
# SLACK_CHANNEL=C0123456789
# 所有服務共用；預設 WARNING 會把爬蟲的 HTTP 520、重試等日常訊息也送出，建議 ERROR（開發規格 7.16）
# SLACK_LOG_LEVEL=ERROR
# SLACK_ENV=dev
