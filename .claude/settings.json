{
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(docker compose:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ae board:*)",
      "Bash(ae task:*)",
      "Bash(ae pr:*)",
      "Bash(ae docs:*)",
      "Bash(ae release open:*)",
      "Bash(ae check-env)",
      "Bash(ae check-env setup)",
      "Bash(ae config)",
      "Bash(ae survey:*)",
      "Bash(gh issue create:*)",
      "Bash(python3 .claude/skills/ui-ux-pro-max/scripts/search.py:*)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(ae board scope:*)",
      "Bash(ae pr approve:*)",
      "Bash(ae pr unblock:*)",
      "Bash(ae release finish:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release upload:*)",
      "Bash(gh repo:*)",
      "Read(**/.env)",
      "Edit(/contracts/**)",
      "Edit(/CLAUDE.md)",
      "Bash(ae adopt:*)",
      "Bash(ae upgrade:*)",
      "Edit(/.claude/**)",
      "Edit(/.agent/config.toml)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "python3 scripts/init_project.py *",
      "docker compose *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/Caches",
        "~/go",
        "~/.m2",
        "~/.gradle"
      ],
      "denyWrite": [
        "./scripts",
        "./contracts",
        "./CLAUDE.md",
        "./.agent/config.toml"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "api.groq.com",
        "api.telegram.org",
        "www.ptt.cc",
        "slack.com",
        "hc-ping.com"
      ],
      "allowLocalBinding": true
    },
    "enableWeakerNetworkIsolation": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard_paths.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard_bash.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "backend|frontend|architect|designer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/validate_report.py\""
          }
        ]
      }
    ]
  }
}
