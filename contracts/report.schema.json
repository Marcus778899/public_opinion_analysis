{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerReport",
  "$comment": "TODO(AE-08): 調整欄位；validate_report.py 依此驗證",
  "type": "object",
  "required": ["task_id", "status", "files_changed", "verification", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "status": { "enum": ["done", "blocked", "failed"] },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "required": ["command", "exit_code", "tail"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "exit_code": { "type": "integer" },
        "tail": { "type": "string", "description": "驗證輸出的最後幾行" }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "disputes": {
      "type": "array",
      "description": "驗收測試與契約矛盾時填（不可改測試）；status 必須是 blocked",
      "items": {
        "type": "object",
        "required": ["test", "contract", "reason"],
        "additionalProperties": false,
        "properties": {
          "test": { "type": "string", "description": "測試檔與名稱，例 acceptance/todo/test_api.py::test_create" },
          "contract": { "type": "string", "description": "契約條文位置，例 docs/contracts/todo.md §2" },
          "reason": { "type": "string", "description": "測試要求什麼、契約寫什麼、哪裡矛盾" }
        }
      }
    }
  }
}
